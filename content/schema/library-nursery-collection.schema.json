{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library.nursery-collection/1.0.0",
  "title": "Library of the Citadel — Agent Nursery collection manifest",
  "description": "An independent collection beside World Recipes and the story shelf. It names a project aspiration and lists the artifacts that actually exist; membership is by stable handbook_id only. Its reader-facing text is held per interface locale inside the manifest, because the collection is bilingual at source rather than English with a translation overlay. The manifest deliberately has no slot for a planned, forthcoming, or placeholder artifact: what is not published is described in prose, never listed as an empty product.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "record_class",
    "handbook_ids",
    "locales",
    "rights",
    "reviewed_at",
    "record_version",
    "change_history"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "library.nursery-collection/1.0.0" },
    "collection_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "record_class": {
      "type": "string",
      "description": "project: a named project, its stated long-term goal, and the work published under it. The class says nothing about whether any institution named by that goal has been established or is operating; the collection's own prose states that.",
      "const": "project"
    },
    "handbook_ids": {
      "type": "array",
      "description": "Editorial order, and the definition of what is published: src/nursery.mjs refuses an id with no record on disk, and refuses a record on disk the manifest does not list.",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "$comment": "see the shared per-locale block below", "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "aspiration_title", "aspiration", "holdings_title", "holdings_note", "scope_note", "collection_notice"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "title_alt": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "aspiration_title": { "type": "string", "minLength": 1 },
            "aspiration": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "holdings_title": { "type": "string", "minLength": 1 },
            "holdings_note": { "type": "string", "minLength": 1 },
            "scope_note": { "type": "string", "minLength": 1 },
            "collection_notice": { "type": "string", "minLength": 20 }
          }
        },
        "zh": { "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "aspiration_title", "aspiration", "holdings_title", "holdings_note", "scope_note", "collection_notice"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "title_alt": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "aspiration_title": { "type": "string", "minLength": 1 },
            "aspiration": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "holdings_title": { "type": "string", "minLength": 1 },
            "holdings_note": { "type": "string", "minLength": 1 },
            "scope_note": { "type": "string", "minLength": 1 },
            "collection_notice": { "type": "string", "minLength": 20 }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_license", "license_review_state", "holders"],
      "properties": {
        "content_license": { "type": "string", "minLength": 1 },
        "license_review_state": {
          "type": "string",
          "enum": ["not-reviewed", "author-original-text", "cleared", "blocked"]
        },
        "holders": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "record_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "change_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "change", "supersedes"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "change": { "type": "string", "minLength": 1 },
          "supersedes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
