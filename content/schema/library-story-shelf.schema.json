{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library.story-shelf/1.0.0",
  "title": "Library of the Citadel story shelf manifest",
  "description": "A story shelf groups literary works the way a collection manifest groups knowledge items: membership is by stable story_id only, and the shelf carries its own version history and rights. Its reader-facing text is held per interface locale inside the manifest, for the same reason a story record holds its own — a shelf of works whose canonical language is not English has no English original for an overlay to fall back to.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shelf_id",
    "story_ids",
    "locales",
    "rights",
    "reviewed_at",
    "record_version",
    "change_history"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "library.story-shelf/1.0.0" },
    "shelf_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "story_ids": {
      "type": "array",
      "description": "Editorial order. It drives the shelf index, and it is the definition of what is published: src/stories.mjs refuses an id with no record on disk, and refuses a record on disk that the manifest does not list.",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "scope_note", "shelf_notice"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "title_alt": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "scope_note": { "type": "string", "minLength": 1 },
            "shelf_notice": { "type": "string", "minLength": 20 }
          }
        },
        "zh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "scope_note", "shelf_notice"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "title_alt": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "scope_note": { "type": "string", "minLength": 1 },
            "shelf_notice": { "type": "string", "minLength": 20 }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_license", "license_review_state", "holders"],
      "properties": {
        "content_license": { "type": "string", "minLength": 1 },
        "license_review_state": {
          "type": "string",
          "enum": ["not-reviewed", "author-original-text", "cleared", "blocked"]
        },
        "holders": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "record_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "change_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "change", "supersedes"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "change": { "type": "string", "minLength": 1 },
          "supersedes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
