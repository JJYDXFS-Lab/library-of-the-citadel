{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library.collection/1.0.0",
  "title": "Library of the Citadel collection manifest",
  "description": "A Library of the Citadel collection groups knowledge items and carries its own provenance and review state. The $id and schema_version are stable identifiers and are deliberately unchanged by the naming decision. Item membership is by stable item_id only, so items stay portable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "record_class",
    "publication_ready",
    "record_notice",
    "title",
    "description",
    "scope_note",
    "item_ids",
    "reviewed_at",
    "record_version",
    "change_history",
    "rights"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "library.collection/1.0.0" },
    "collection_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "record_class": { "type": "string", "enum": ["fixture", "sourced"] },
    "publication_ready": { "type": "boolean" },
    "record_notice": { "type": "string", "minLength": 20 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "alt": { "type": "array", "items": { "type": "string" } }
      }
    },
    "description": { "type": "string", "minLength": 1 },
    "scope_note": {
      "type": "string",
      "description": "What this collection deliberately does and does not contain.",
      "minLength": 1
    },
    "item_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "record_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "change_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "change", "supersedes"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "change": { "type": "string", "minLength": 1 },
          "supersedes": { "type": ["string", "null"] }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_license", "license_review_state"],
      "properties": {
        "content_license": { "type": "string", "minLength": 1 },
        "license_review_state": {
          "type": "string",
          "enum": ["not-reviewed", "fixture-original-text", "cleared", "blocked"]
        }
      }
    }
  }
}
